{"type": "运行JS代码", "delay": "0", "delayUnit": 0, "desc": "一些基础函数", "jsCode": "\"use strict\";Array.prototype.remove=function(n){var t=this.indexOf(n);t>-1&&this.splice(t,1)};Array.prototype.add=function(n){var t=this.indexOf(n);t==-1&&this.push(n)};Array.prototype.insert=function(n,t){this.splice(n,0,t)};Array.prototype.without=function(n){for(var i=[],t=0;t<this.length;t++)n&&n.length>0&&n.indexOf(this[t])!=-1||i.push(this[t]);return i};Array.prototype.contains=function(n){return this.indexOf(n)!=-1};Array.prototype.clone=function(){var t=[],n;for(t.length=this.length,n=0;n<this.length;n++)t[n]=this[n];return t};Array.prototype.containCount=function(n){for(var i=0,t=0;t<this.length;t++)this[t]==n&&i++;return i};Array.prototype.reverseNew=function(){for(var t=[],n=this.length;n>0;)n--,t.push(this[n]);return t};String.prototype.contains=function(n){return this.indexOf(n)!=-1};String.prototype.format=function(){var t,n,i;if(arguments.length>0){for(t=this,n=0;n<arguments.length;n++)i=\"{\"+n+\"}\",t=t.replace(i,typeof arguments[n]!=\"string\"?JSON.stringify(arguments[n]):arguments[n]);return t}return String(this)};String.prototype.containsAny=function(n){var i,t;if(arguments.length>1){for(t=0;t<arguments.length;t++)if(this.indexOf(arguments[t])!=-1)return!0}else if(n instanceof Array){for(i in n)if(this.indexOf(i)!=-1)return!0}else if(typeof n==\"string\"){for(t=0;t<n.length;t++)if(this.indexOf(n[t])!=-1)return!0}else throw new v6.error.NotSupported(\"not implement\");return!1};v6.base.clone=function(n){return n===null?null:n===undefined?null:n.clone?n.clone():n instanceof Object?JSON.parse(JSON.stringify(n)):null};window.clone=v6.base.clone;v6.base.randomInt=function(){return parseInt(v6.base.random.apply(v6.base,arguments))};v6.base.random=function(n,t){if(arguments.length==1)return Math.random(n);if(arguments.length==2){if(t>n){var i=t;t=n;n=i}return t+Math.random()*(n-t)}throw new v6.error.NotImplement(\"not implement\");};v6.base.getDefaultValue=function(n){var t=