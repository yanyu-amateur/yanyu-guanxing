宰杀牛、南阳日常等)，接着去到洛阳继续执行动作，然后去落霞镇。\\r\\n部分地图没有相关动作要执行，则会尽可能的跳过这些地图\",\"绕全地图说明\"),v6.ui.manager.refreshAsync(n)},showByOrderDesc:async function(n){return v6.zdjl.alert(n,\"顺序执行是在“绕全地图”阶段执行完成后才开始的。\\r\\n这个阶段的动作，脚本按照界面上动作先后顺序，逐个运行，通常是把地图位置相近的动作放在一起，而不是按类别放一起；\\r\\n比如厂狱是跟周石天放一起，而没有跟燕王府放一起，是因为厂狱跟周石天都在洛阳，而燕王府在幽州；\\r\\n自定义子脚本建议放在这个阶段(而不是绕全地图阶段)，主要是因为游戏做了点击无效化干扰，且自动精灵不稳定等因素，子脚本可能不够稳定，任何异常都可能会让脚本无法继续执行下去，导致脚本没执行多少动作就停止了。\\r\\n部分有使用自定义子脚本的玩家，建议去“全局设置”(首屏底部)中勾选“是否显示序号”，这有利于自行对自定义子脚本进行排顺序\\r\\n注：自定义子脚本需要自动精灵文件夹内有相关子脚本才可以使用\",\"顺序执行说明\"),v6.ui.manager.refreshAsync(n)},showCircleDesc:async function(n){return v6.zdjl.alert(n,\"循环组合是在“顺序执行”阶段完成后才开始的，进入循环阶段后，脚本即使被中断也不会有“继续执行”的功能。\\r\\n这个阶段的动作，都是可以多次执行的，比如1小时刷一次牛羊，几分钟弹一次琴。\\r\\n循环组合阶段，可以同时配置多个任务，特别推荐在这个阶段执行钓鱼，算法会利用碎片时间去钓鱼；\\r\\n循环阶段不会自动停止，你需要为它指定停止的条件，比如电量不足20%时停止运行；\\r\\n\",\"循环组合说明\"),v6.ui.manager.refreshAsync(n)},showExitDesc:async function(n){return v6.zdjl.alert(n,\"结束动作，脚本结束时执行特定的动作。\\r\\n\",\"结束时执行说明\"),v6.ui.manager.refreshAsync(n)},resetAppData:async function(n){if(v6.zdjl.confirm(n,\"是否清空全局配置数据\",\"警告\"))v6.data.setting.reset(n),v6.data.appData.reset(n),v6.zdjl.stop(n);else return v6.ui.manager.refreshAsync(n)},editRestart:async function(n){var t=new v6.ui.pages.EditRestart;return v6.ui.manager.showAsync(n,t)},editHack:async function(n){var t=new v6.ui.pages.EditHack;return v6.ui.manager.showAsync(n,t)},addHack:async function(n){let t=v6.zdjl.getVar(n,v6.ui.pages.EditHack.HackKey);if(t){let i=v6.data.setting.hacks;i||(i=[]);i.indexOf(t)!=-1?v6.zdjl.alert(\"重复的秘技指令:\"+t):(i.push(t),v6.data.setting.setHacks(n,i))}else v6.zdjl.alert(\"请输入秘技指令\");return v6.ui.manager.refreshAsync(n)},removeHack:async function(n,t){let i=v6.data.setting.hacks;if(!i||t<0||t>=i.length)v6.zdjl.alert(\"删除指令异常，请重启脚本\");else{let i=v6.data.setting.hacks;i.splice(t,1);v6.data.setting.setHacks(n,i)}return v6.ui.manager.refreshAsync(n)},editActionDetailConfigPageGroupType:async function(n,t){let i=v6.ui.manager.getCurPage();return i.setVarDataToWholeTarget(