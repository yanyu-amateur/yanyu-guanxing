{"type": "运行JS代码", "delay": "0", "delayUnit": 0, "desc": "异常", "jsCode": "\"use strict\";v6.about.type=\"test\";v6.error.menu=[{question:\"APP闪退\",answer:\"APP闪退通常是被系统杀了，可以看使用说明中闪退的部分，或自己百度你用的手机应该如何保护进程不被系统杀了；另外的闪退是由于自动精灵的文字识别接口引起的，下载自动精灵APP的页面，有64位版本跟兼容版本，2个版本都下载逐个安装试试\"},{question:\"x must be <= screenWidth\",answer:\"烟雨强制横屏显示，自动精灵APP根据某种规则，认为当前是竖屏，就出错了。引起自动精灵识别为竖屏的只有两种可能性：系统当前还是竖屏（可以试试开启或关闭系统的“自动旋转”），另外一种是“重力感应球”引起的，解决方案为“把手机或平板立起来或斜着摆放，而不是平摊在桌面上”\"},];v6.error.Error=(class extends Error{msg;internal;constructor(n){super(n);this.msg=n;this.funs=v6.stack.output();v6.console.error(this.name,this.message,\"\\r\\n\",this.stack)}get name(){return\"error\"}});v6.error.Stop=(class extends v6.error.Error{title;duration;isShow;constructor(n,t=\"重要信息\",i=true,r=0){super(n);this.title=t;this.duration=r;this.isShow=i}get name(){return\"Stop\"}});v6.error.Internal=(class extends v6.error.Error{constructor(n){super(\"内部错误【\"+n+\"】\")}get name(){return\"Internal\"}});v6.error.Jump=(class extends v6.error.Error{constructor(n){super(\"轻功异常【\"+n+\"】\")}get name(){return\"Jump\"}});v6.error.NotImplement=(class extends v6.error.Error{constructor(n){super(\"【\"+n+\"】未实现\")}get name(){return\"NotImplement\"}});v6.error.Unrecognize=(class extends v6.error.Error{constructor(n){super(\"无法识别【\"+n+\"】\")}get name(){return\"Unrecognize\"}});v6.error.NotFound=(class extends v6.error.Error{constructor(n){super(\"【\"+n+\"】未找到\")}get name(){return\"NotFound\"}});v6.error.NotFoundImage=(class extends v6.error.Error{constructor(n){super(\"图片【\"+n+\"】未找到\")}get name(){return\"NotFoundImage\"}});v6.error.OutOfRange=(class extends v6.error.Error{constructor(n){super(\"参数\"+n+\"超出范围\")}get name(){return\"OutOfRange\"}});v6.error.InvalidArguments=(class extends v6.error.Error{constructor(n){super(\"参数不正确【\"+n+\"】\")}get name(){return\"InvalidArguments\"}});v6.error.NullPointer=(class extends v6.error.Error{constructor(n=\"\"){super(n?\"参数不可为空\":n)}get name(){return\"NullPointer\"}});v6.error.TypeError